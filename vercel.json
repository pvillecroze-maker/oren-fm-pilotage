{
  "version": 2,
  "framework": null,
  "buildCommand": "bash scripts/build-oren.sh",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/metis.html",
      "has": [
        {
          "type": "host",
          "value": "janus-oren-patrick-os.vercel.app"
        }
      ],
      "destination": "https://metis-oren-patrick-os.vercel.app/metis.html",
      "permanent": false
    },
    {
      "source": "/music/:path*",
      "has": [
        {
          "type": "host",
          "value": "janus-oren-patrick-os.vercel.app"
        }
      ],
      "destination": "https://metis-oren-patrick-os.vercel.app/music/:path*",
      "permanent": false
    },
    {
      "source": "/hermes.html",
      "has": [
        {
          "type": "host",
          "value": "janus-oren-patrick-os.vercel.app"
        }
      ],
      "destination": "https://metis-oren-patrick-os.vercel.app/hermes.html",
      "permanent": false
    },
    {
      "source": "/metis/:path*",
      "has": [
        {
          "type": "host",
          "value": "janus-oren-patrick-os.vercel.app"
        }
      ],
      "destination": "https://metis-oren-patrick-os.vercel.app/metis/:path*",
      "permanent": false
    },
    {
      "source": "/metis/janus.html",
      "destination": "/janus.html",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
