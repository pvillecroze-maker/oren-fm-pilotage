{
  "version": 2,
  "framework": null,
  "buildCommand": "bash scripts/build-oren.sh",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/metis/janus.html",
      "destination": "/janus.html",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
